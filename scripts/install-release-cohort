#!/usr/bin/env python3
"""Install one coherent Faculties binary cohort and atomically activate it."""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
from pathlib import Path
from pathlib import PurePosixPath
import platform
import re
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
from typing import Any, Iterator


GENERATION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
BINARY_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
REQUIRED_COHORT_BINARIES = frozenset({"migrations"})
BUILD_ENVIRONMENT = ("RUSTFLAGS", "CARGO_INCREMENTAL")
HEX_40_RE = re.compile(r"^[0-9a-f]{40}$")
HEX_64_RE = re.compile(r"^[0-9a-f]{64}$")
READ_LIMIT = 16 << 20
PROCESS_FILES = {
    "executable": "exe",
    "mapped file": "maps",
    "open file": "fd",
    "working directory": "cwd",
    "environment": "environ",
    "command line": "cmdline",
}
UNIT_PROPERTIES = (
    "--property=Id,ExecStart,ExecStartPre,ExecStartPost,ExecStop,ExecReload,Environment"
)


class ReleaseError(RuntimeError):
    pass


def run(*args: str, cwd: Path | None = None) -> str:
    try:
        result = subprocess.run(
            args,
            cwd=cwd,
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except (OSError, subprocess.CalledProcessError) as error:
        detail = getattr(error, "stderr", "") or str(error)
        raise ReleaseError(f"{' '.join(args)} failed: {detail.strip()}") from error
    return result.stdout


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fsync_file(path: Path) -> None:
    with path.open("rb") as file:
        os.fsync(file.fileno())


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def discover_binaries(build_dir: Path) -> list[Path]:
    if not build_dir.is_dir():
        raise ReleaseError(f"build directory does not exist: {build_dir}")
    binaries: list[Path] = []
    for candidate in build_dir.iterdir():
        if candidate.is_symlink() or not candidate.is_file():
            continue
        if not os.access(candidate, os.X_OK):
            continue
        if not BINARY_RE.fullmatch(candidate.name):
            raise ReleaseError(
                f"unsafe executable name in build directory: {candidate.name!r}"
            )
        binaries.append(candidate)
    if not binaries:
        raise ReleaseError(f"no executable files found directly in {build_dir}")
    missing = REQUIRED_COHORT_BINARIES.difference(
        candidate.name for candidate in binaries
    )
    if missing:
        names = ", ".join(sorted(missing))
        raise ReleaseError(
            f"required cohort binary is absent from {build_dir}: {names}; "
            "build with `cargo build --release --workspace --bins`"
        )
    return sorted(binaries, key=lambda path: path.name)


def stable_name(binary_name: str) -> str:
    # Do not shadow the operating system's mail(1).
    return "faculties-mail" if binary_name == "mail" else binary_name


def cargo_metadata(
    source_dir: Path, *, no_default_features: bool, features: list[str]
) -> dict[str, Any]:
    command = [
        "cargo",
        "metadata",
        "--format-version",
        "1",
        "--locked",
        "--manifest-path",
        str(source_dir / "Cargo.toml"),
    ]
    if no_default_features:
        command.append("--no-default-features")
    if features:
        command.extend(("--features", ",".join(features)))
    try:
        return json.loads(run(*command, cwd=source_dir))
    except json.JSONDecodeError as error:
        raise ReleaseError("cargo metadata returned invalid JSON") from error


def source_repositories(
    source_dir: Path, metadata: dict[str, Any]
) -> list[dict[str, Any]]:
    packages = {package["id"]: package for package in metadata["packages"]}
    resolved_ids = {node["id"] for node in metadata["resolve"]["nodes"]}
    repo_packages: dict[Path, dict[str, set[Any]]] = {}

    for package_id in resolved_ids:
        package = packages[package_id]
        if package.get("source") is not None:
            continue
        manifest_dir = Path(package["manifest_path"]).resolve().parent
        try:
            root = Path(
                run("git", "rev-parse", "--show-toplevel", cwd=manifest_dir).strip()
            )
        except ReleaseError as error:
            raise ReleaseError(
                f"local package {package['name']} is not in a Git repository"
            ) from error
        root = root.resolve()
        repository = repo_packages.setdefault(
            root, {"names": set(), "directories": set()}
        )
        repository["names"].add(package["name"])
        repository["directories"].add(manifest_dir.relative_to(root))

    repositories: list[dict[str, Any]] = []
    for root, repository in sorted(
        repo_packages.items(), key=lambda item: str(item[0])
    ):
        paths = [str(path) or "." for path in sorted(repository["directories"])]
        # Limit dirtiness to package directories in Cargo's resolved local
        # graph. Untracked siblings and target/ trees are unrelated build
        # state. Tracked selected-package changes make HEAD's tree hash
        # insufficient provenance; untracked files are deliberately outside
        # the claimed Git tree rather than guessed to be build inputs.
        changed = run(
            "git", "diff", "--name-only", "-z", "HEAD", "--", *paths, cwd=root
        )
        relevant = sorted(
            {
                path
                for path in changed.split("\0")
                if path and "target" not in Path(path).parts
            }
        )
        if relevant:
            summary = ", ".join(relevant[:5])
            raise ReleaseError(f"source repository is dirty: {root} ({summary})")
        repositories.append(
            {
                "path": os.path.relpath(root, source_dir),
                "revision": run("git", "rev-parse", "HEAD", cwd=root).strip(),
                "tree": run("git", "rev-parse", "HEAD^{tree}", cwd=root).strip(),
                "packages": sorted(repository["names"]),
            }
        )
    return repositories


def parse_features(value: str) -> list[str]:
    features = sorted(
        {feature.strip() for feature in value.split(",") if feature.strip()}
    )
    invalid = [feature for feature in features if not BINARY_RE.fullmatch(feature)]
    if invalid:
        raise ReleaseError(f"invalid Cargo feature name: {invalid[0]!r}")
    return features


def require_exact_keys(value: dict[str, Any], expected: set[str], subject: str) -> None:
    actual = set(value)
    if actual != expected:
        missing = ", ".join(sorted(expected - actual))
        extra = ", ".join(sorted(actual - expected))
        detail = []
        if missing:
            detail.append(f"missing {missing}")
        if extra:
            detail.append(f"unexpected {extra}")
        raise ReleaseError(f"invalid {subject} fields: {'; '.join(detail)}")


def validate_runner(value: Any, subject: str) -> dict[str, str]:
    if not isinstance(value, dict):
        raise ReleaseError(f"{subject} must be an object")
    require_exact_keys(value, {"path", "revision", "sha256"}, subject)
    path = value["path"]
    revision = value["revision"]
    digest = value["sha256"]
    if not isinstance(path, str) or not path:
        raise ReleaseError(f"{subject}.path must be a nonempty relative string")
    parsed_path = PurePosixPath(path)
    if (
        parsed_path.is_absolute()
        or parsed_path == PurePosixPath(".")
        or any(part in {"", ".", ".."} for part in parsed_path.parts)
        or parsed_path.as_posix() != path
    ):
        raise ReleaseError(f"{subject}.path must be a normalized relative path")
    if not isinstance(revision, str) or not HEX_40_RE.fullmatch(revision):
        raise ReleaseError(
            f"{subject}.revision must be 40 lowercase hexadecimal characters"
        )
    if not isinstance(digest, str) or not HEX_64_RE.fullmatch(digest):
        raise ReleaseError(
            f"{subject}.sha256 must be 64 lowercase hexadecimal characters"
        )
    return {"path": path, "revision": revision, "sha256": digest}


def validate_command(value: Any, subject: str) -> list[str]:
    if (
        not isinstance(value, list)
        or not value
        or any(not isinstance(argument, str) for argument in value)
    ):
        raise ReleaseError(f"{subject} must be a nonempty array of strings")
    return list(value)


def parse_exact_invocation(value: str) -> dict[str, Any]:
    try:
        receipt = json.loads(value)
    except json.JSONDecodeError as error:
        raise ReleaseError("GB10_EXACT_INVOCATION is not valid JSON") from error
    if not isinstance(receipt, dict):
        raise ReleaseError("GB10_EXACT_INVOCATION must be an object")
    require_exact_keys(
        receipt,
        {"format", "runner", "source_cohort_sha256", "command"},
        "GB10_EXACT_INVOCATION",
    )
    if type(receipt["format"]) is not int or receipt["format"] != 1:
        raise ReleaseError("GB10_EXACT_INVOCATION.format must be 1")
    source_digest = receipt["source_cohort_sha256"]
    if not isinstance(source_digest, str) or not HEX_64_RE.fullmatch(source_digest):
        raise ReleaseError(
            "GB10_EXACT_INVOCATION.source_cohort_sha256 must be 64 lowercase "
            "hexadecimal characters"
        )
    return {
        "runner": validate_runner(
            receipt["runner"], "GB10_EXACT_INVOCATION.runner"
        ),
        "source_cohort_sha256": source_digest,
        "command": validate_command(
            receipt["command"], "GB10_EXACT_INVOCATION.command"
        ),
    }


def build_recipe_from_environment() -> dict[str, Any]:
    recipe: dict[str, Any] = {
        "format": 1,
        "environment": {
            name: os.environ[name] for name in BUILD_ENVIRONMENT if name in os.environ
        },
        "cargo_version_verbose": run("cargo", "--version", "--verbose").rstrip(),
    }
    exact_invocation = os.environ.get("GB10_EXACT_INVOCATION")
    if exact_invocation is not None:
        recipe.update(parse_exact_invocation(exact_invocation))
    return recipe


def validate_build_recipe(value: Any) -> None:
    if not isinstance(value, dict):
        raise ReleaseError("staged build_recipe must be an object")
    base_fields = {"format", "environment", "cargo_version_verbose"}
    exact_fields = {"runner", "source_cohort_sha256", "command"}
    fields = set(value)
    present_exact = fields & exact_fields
    if present_exact and present_exact != exact_fields:
        raise ReleaseError(
            "staged build_recipe runner, source_cohort_sha256, and command must be present together"
        )
    require_exact_keys(
        value,
        base_fields | (exact_fields if present_exact else set()),
        "staged build_recipe",
    )
    if type(value["format"]) is not int or value["format"] != 1:
        raise ReleaseError("staged build_recipe.format must be 1")
    environment = value["environment"]
    if not isinstance(environment, dict):
        raise ReleaseError("staged build_recipe.environment must be an object")
    if any(name not in BUILD_ENVIRONMENT for name in environment):
        raise ReleaseError(
            "staged build_recipe.environment contains an unallowlisted name"
        )
    if any(not isinstance(item, str) for item in environment.values()):
        raise ReleaseError("staged build_recipe.environment values must be strings")
    cargo_version = value["cargo_version_verbose"]
    if not isinstance(cargo_version, str) or not cargo_version:
        raise ReleaseError(
            "staged build_recipe.cargo_version_verbose must be a nonempty string"
        )
    if present_exact:
        validate_runner(value["runner"], "staged build_recipe.runner")
        source_digest = value["source_cohort_sha256"]
        if not isinstance(source_digest, str) or not HEX_64_RE.fullmatch(source_digest):
            raise ReleaseError(
                "staged build_recipe.source_cohort_sha256 must be 64 lowercase "
                "hexadecimal characters"
            )
        validate_command(value["command"], "staged build_recipe.command")


def expected_link(prefix: Path, binary: str) -> str:
    destination = prefix / "lib" / "faculties" / "current" / "bin" / binary
    return os.path.relpath(destination, prefix / "bin")


def read_previous_links(current: Path) -> dict[str, str]:
    manifest_path = current / "manifest.json"
    if not manifest_path.is_file():
        return {}
    try:
        manifest = json.loads(manifest_path.read_text())
        return {
            item["link_name"]: item["name"]
            for item in manifest.get("binaries", [])
            if isinstance(item.get("link_name"), str)
            and isinstance(item.get("name"), str)
        }
    except (OSError, json.JSONDecodeError, KeyError, TypeError) as error:
        raise ReleaseError(
            f"cannot read current release manifest: {manifest_path}"
        ) from error


def preflight_links(prefix: Path, links: dict[str, str]) -> None:
    seen: set[str] = set()
    for link_name, binary_name in links.items():
        if link_name in seen:
            raise ReleaseError(
                f"stable command name {link_name!r} is claimed by multiple binaries"
            )
        seen.add(link_name)
        path = prefix / "bin" / link_name
        target = expected_link(prefix, binary_name)
        if os.path.lexists(path):
            if not path.is_symlink() or os.readlink(path) != target:
                raise ReleaseError(f"refusing to replace unmanaged command: {path}")


def preflight_path(prefix: Path, links: dict[str, str], path_value: str) -> None:
    """Refuse activation when another executable would shadow this cohort.

    We inspect PATH exactly as the caller supplied it. Activation cannot make
    ``prefix/bin`` win over an earlier directory, and silently succeeding in
    that state gives the operator a coherent installed generation that no
    ordinary command actually reaches.
    """
    command_dir = (prefix / "bin").resolve()
    if not path_value:
        raise ReleaseError(
            f"PATH is empty; activation would not make {command_dir} directly invocable"
        )
    entries = [
        Path(entry or ".").expanduser().resolve()
        for entry in path_value.split(os.pathsep)
    ]
    try:
        managed_index = entries.index(command_dir)
    except ValueError as error:
        raise ReleaseError(
            f"{command_dir} is absent from PATH; activation would not make the managed "
            "Faculties cohort directly invocable"
        ) from error

    for earlier in entries[:managed_index]:
        for link_name in sorted(links):
            candidate = earlier / link_name
            if candidate.is_file() and os.access(candidate, os.X_OK):
                raise ReleaseError(
                    f"PATH shadows managed Faculties command {link_name!r}: {candidate} "
                    f"precedes {command_dir / link_name}. Remove/archive the stale binary or "
                    f"place {command_dir} earlier in PATH; nothing was activated"
                )


def links_for_binaries(binaries: list[Path]) -> dict[str, str]:
    links: dict[str, str] = {}
    for binary in binaries:
        link_name = stable_name(binary.name)
        if link_name in links:
            raise ReleaseError(
                f"stable command name {link_name!r} is claimed by multiple binaries"
            )
        links[link_name] = binary.name
    return links


def manifest_for(
    *,
    generation: str,
    build_dir: Path,
    source_dir: Path,
    binaries: list[Path],
    repositories: list[dict[str, Any]],
    lock_path: Path,
    no_default_features: bool,
    features: list[str],
    resolved_features: list[str],
) -> dict[str, Any]:
    return {
        "format": 1,
        "generation": generation,
        "created_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "platform": platform.platform(),
        "build_directory": str(build_dir),
        "cargo": {
            "default_features": not no_default_features,
            "features": features,
            "resolved_features": resolved_features,
            "lockfile": "Cargo.lock",
            "lockfile_sha256": sha256(lock_path),
        },
        "build_recipe": build_recipe_from_environment(),
        # From the source checkout, so rustup applies its rust-toolchain.toml
        # pin; from the caller's cwd this recorded whatever toolchain applied
        # there (1.97.1 against a 1.98.0 build in the 2026-11-15 cohort).
        "rustc": run("rustc", "--version", "--verbose", cwd=source_dir).rstrip(),
        "sources": repositories,
        "binaries": [
            {
                "name": binary.name,
                "link_name": stable_name(binary.name),
                "size": binary.stat().st_size,
                "sha256": sha256(binary),
            }
            for binary in binaries
        ],
    }


def atomic_symlink(target: str, destination: Path) -> None:
    temporary = destination.with_name(f".{destination.name}.{os.getpid()}.new")
    if os.path.lexists(temporary):
        temporary.unlink()
    os.symlink(target, temporary)
    os.replace(temporary, destination)


def stage_release(args: argparse.Namespace) -> tuple[str, dict[str, Any]]:
    source_dir = args.source_dir.resolve()
    if args.build_dir is None:
        raise ReleaseError("build_dir is required unless --activate-staged is used")
    build_dir = args.build_dir.resolve()
    prefix = args.prefix.expanduser().resolve()
    features = parse_features(args.features)
    generation = args.generation
    if generation is None:
        revision = run("git", "rev-parse", "--short=12", "HEAD", cwd=source_dir).strip()
        stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        generation = f"{stamp}-{revision}"
    if not GENERATION_RE.fullmatch(generation):
        raise ReleaseError(f"invalid generation name: {generation!r}")

    lock_path = source_dir / "Cargo.lock"
    if not lock_path.is_file():
        raise ReleaseError(f"Cargo.lock does not exist: {lock_path}")
    binaries = discover_binaries(build_dir)
    links_for_binaries(binaries)
    metadata = cargo_metadata(
        source_dir,
        no_default_features=args.no_default_features,
        features=features,
    )
    repositories = source_repositories(source_dir, metadata)
    root_id = metadata["resolve"].get("root")
    resolved_features = sorted(
        next(
            (
                node["features"]
                for node in metadata["resolve"]["nodes"]
                if node["id"] == root_id
            ),
            [],
        )
    )
    manifest = manifest_for(
        generation=generation,
        build_dir=build_dir,
        source_dir=source_dir,
        binaries=binaries,
        repositories=repositories,
        lock_path=lock_path,
        no_default_features=args.no_default_features,
        features=features,
        resolved_features=resolved_features,
    )
    if args.dry_run:
        print(json.dumps(manifest, indent=2, sort_keys=True))
        return generation, manifest

    release_root = prefix / "lib" / "faculties"
    releases = release_root / "releases"
    release_dir = releases / generation
    if os.path.lexists(release_dir):
        raise ReleaseError(f"release generation already exists: {release_dir}")

    releases.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=f".{generation}.", dir=releases))
    try:
        stage_bin = stage / "bin"
        stage_bin.mkdir()
        for source in binaries:
            destination = stage_bin / source.name
            shutil.copy2(source, destination)
            destination.chmod(destination.stat().st_mode | stat.S_IXUSR)
            if sha256(destination) != sha256(source):
                raise ReleaseError(f"copy verification failed for {source.name}")
            fsync_file(destination)
        shutil.copy2(lock_path, stage / "Cargo.lock")
        fsync_file(stage / "Cargo.lock")
        manifest_path = stage / "manifest.json"
        manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        fsync_file(manifest_path)
        fsync_directory(stage_bin)
        fsync_directory(stage)
        os.rename(stage, release_dir)
        fsync_directory(releases)
    except BaseException:
        if stage.exists():
            shutil.rmtree(stage)
        raise
    print(f"staged Faculties release {generation} ({len(binaries)} binaries)")
    return generation, manifest


def validate_staged_release(
    release_dir: Path, generation: str
) -> tuple[dict[str, Any], dict[str, str]]:
    manifest_path = release_dir / "manifest.json"
    try:
        manifest = json.loads(manifest_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ReleaseError(
            f"cannot read staged release manifest: {manifest_path}"
        ) from error
    if manifest.get("format") != 1 or manifest.get("generation") != generation:
        raise ReleaseError(
            f"staged release manifest does not name generation {generation}"
        )
    if "build_recipe" in manifest:
        validate_build_recipe(manifest["build_recipe"])
    cargo = manifest.get("cargo")
    if not isinstance(cargo, dict):
        raise ReleaseError("staged release manifest has no Cargo provenance")
    lock_path = release_dir / "Cargo.lock"
    if not lock_path.is_file() or sha256(lock_path) != cargo.get("lockfile_sha256"):
        raise ReleaseError("staged Cargo.lock does not match its manifest hash")

    items = manifest.get("binaries")
    if not isinstance(items, list) or not items:
        raise ReleaseError("staged release manifest has no binaries")
    links: dict[str, str] = {}
    names: set[str] = set()
    for item in items:
        if not isinstance(item, dict):
            raise ReleaseError("invalid binary entry in staged release manifest")
        name = item.get("name")
        link_name = item.get("link_name")
        if not isinstance(name, str) or not BINARY_RE.fullmatch(name) or name in names:
            raise ReleaseError(f"invalid or duplicate staged binary name: {name!r}")
        if link_name != stable_name(name) or link_name in links:
            raise ReleaseError(f"invalid or duplicate stable link for binary {name!r}")
        path = release_dir / "bin" / name
        if path.is_symlink() or not path.is_file() or not os.access(path, os.X_OK):
            raise ReleaseError(f"staged binary is absent or not executable: {path}")
        if path.stat().st_size != item.get("size") or sha256(path) != item.get(
            "sha256"
        ):
            raise ReleaseError(f"staged binary does not match its manifest: {name}")
        names.add(name)
        links[link_name] = name
    actual_names = {
        path.name
        for path in (release_dir / "bin").iterdir()
        if path.is_file() or path.is_symlink()
    }
    if actual_names != names:
        raise ReleaseError("staged bin directory and manifest contain different files")
    return manifest, links


def activate_staged(prefix: Path, generation: str, *, dry_run: bool) -> dict[str, Any]:
    if not GENERATION_RE.fullmatch(generation):
        raise ReleaseError(f"invalid generation name: {generation!r}")
    prefix = prefix.expanduser().resolve()
    release_root = prefix / "lib" / "faculties"
    release_dir = release_root / "releases" / generation
    current = release_root / "current"
    command_dir = prefix / "bin"
    manifest, links = validate_staged_release(release_dir, generation)
    preflight_links(prefix, links)
    preflight_path(prefix, links, os.environ.get("PATH", ""))
    for link in (current, release_root / "previous"):
        if os.path.lexists(link) and not link.is_symlink():
            raise ReleaseError(f"{link.name} is not a symlink: {link}")
    if dry_run:
        print(json.dumps(manifest, indent=2, sort_keys=True))
        return manifest

    previous_links = read_previous_links(current) if current.is_symlink() else {}
    command_dir.mkdir(parents=True, exist_ok=True)

    created_links: list[Path] = []
    try:
        for link_name, binary_name in links.items():
            path = command_dir / link_name
            if not os.path.lexists(path):
                os.symlink(expected_link(prefix, binary_name), path)
                created_links.append(path)
        before = linked_generation(current)
        if before not in (None, generation):
            atomic_symlink(f"releases/{before}", release_root / "previous")
        atomic_symlink(f"releases/{generation}", current)
        fsync_directory(release_root)
        fsync_directory(command_dir)
    except BaseException:
        for path in created_links:
            path.unlink(missing_ok=True)
        raise

    for link_name, old_binary in previous_links.items():
        if link_name in links:
            continue
        path = command_dir / link_name
        if path.is_symlink() and os.readlink(path) == expected_link(prefix, old_binary):
            path.unlink()
    fsync_directory(command_dir)
    for link_name, binary_name in links.items():
        command, binary = command_dir / link_name, release_dir / "bin" / binary_name
        if not command.exists() or not command.samefile(binary):
            raise ReleaseError(f"activated, but {command} does not reach {binary}")
    print(f"activated Faculties release {generation} ({len(links)} binaries)")
    print(
        "warning: already-running Faculties processes still execute their previous "
        "release; restart long-lived writers such as `orient wait` and verify the "
        "mapped executable with `lsof -a -d txt -p <pid>`",
        file=sys.stderr,
    )
    return manifest


def linked_generation(link: Path) -> str | None:
    parent, _, name = (os.readlink(link) if link.is_symlink() else "").rpartition("/")
    return name if parent == "releases" and GENERATION_RE.fullmatch(name) else None


def capped(source: Any) -> bytes:
    data = source.read(READ_LIMIT + 1)
    if len(data) > READ_LIMIT:
        raise OSError(f"more than {READ_LIMIT} bytes")
    return data


def plain_file(path: Path) -> bytes:
    """What a regular file holds; opening neither follows a symlink nor waits."""
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with open(descriptor, "rb") as file:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise OSError("not a plain file")
        return capped(file)


def output(*args: str) -> bytes:
    environment = {"XDG_RUNTIME_DIR": f"/run/user/{os.getuid()}", **os.environ}
    with subprocess.Popen(args, stdout=subprocess.PIPE, env=environment) as command:
        try:
            text = capped(command.stdout)
        except OSError:
            command.kill()
            raise
    if command.returncode and args[0] != "lsof":  # which exits 1 over any one file
        raise OSError(f"{' '.join(args)} exited {command.returncode}")
    return text


def process_text(base: str, file: str) -> bytes:
    if file in ("exe", "cwd"):
        return os.fsencode(os.readlink(f"{base}/{file}"))
    if file != "fd":
        with open(f"{base}/{file}", "rb") as opened:
            return capped(opened)
    targets = []
    for entry in os.listdir(f"{base}/fd"):
        try:
            targets.append(os.fsencode(os.readlink(f"{base}/fd/{entry}")))
        except FileNotFoundError:
            pass  # closed meanwhile, the others still count
    return b"\n".join(targets)


def linux_holders(unread: set[str]) -> Iterator[tuple[str, str, bytes]]:
    """What every process and loaded unit names: (who, how, text)."""
    for pid in filter(str.isdigit, os.listdir("/proc")):
        if int(pid) == os.getpid():
            continue
        for how, file in PROCESS_FILES.items():
            try:
                who = f"pid {pid} {Path('/proc', pid, 'comm').read_text(errors='replace').strip()}"
                yield who, how, process_text(f"/proc/{pid}", file)
            except PermissionError:
                if how == "mapped file":  # a kernel thread's is empty, not refused
                    unread.add(pid)
            except (FileNotFoundError, ProcessLookupError):
                pass  # it ended
    if Path("/run/systemd/system").is_dir():
        # --all: the default shows active units only, and a stopped one can start.
        for manager in ("--user", "--system"):
            shown = output("systemctl", manager, "show", "*", "--all", UNIT_PROPERTIES)
            for unit in shown.split(b"\n\n"):
                name = re.search(rb"^Id=(.*)$", unit, re.MULTILINE)
                yield f"unit {name[1].decode() if name else '?'}", "loaded", unit


def macos_holders(_unread: set[str]) -> Iterator[tuple[str, str, bytes]]:
    kinds = {b"txt": "executable or mapped file", b"cwd": "working directory"}
    who = how = ""
    listed = output("lsof", "-nPw", "-Fpcfn")
    if f"p{os.getpid()}\n".encode() not in listed:
        raise OSError("lsof did not list this process")
    for line in listed.splitlines():
        if line[:1] == b"p":
            who = f"pid {line[1:].decode()}"
        elif line[:1] == b"c":
            who += " " + line[1:].decode(errors="replace")
        elif line[:1] == b"f":
            how = kinds.get(line[1:], "open file")
        elif line[:1] == b"n" and who.split()[1] != str(os.getpid()):
            yield who, how, line
    for line in output("ps", "-axEww", "-o", "pid=,command=").splitlines():
        pid = line.split()[0].decode()
        if int(pid) != os.getpid():
            yield f"pid {pid}", "command line or environment", line
    for domain in (f"gui/{os.getuid()}", f"user/{os.getuid()}"):
        text = output("launchctl", "print", domain)
        services = re.search(rb"^\tservices = \{\n(.*?)^\t\}", text, re.MULTILINE | re.DOTALL)
        if services is None:
            raise OSError(f"launchctl print {domain} lists no services")
        for row in services[1].splitlines():
            label = row.split()[-1].decode()
            if not label.startswith("com.apple."):
                yield f"agent {label}", "loaded", output("launchctl", "print", f"{domain}/{label}")


def in_use(release_dir: Path) -> str | None:
    """Linux refuses a write lease while any process, also one we cannot read,
    executes, maps or has the file open."""
    signal.signal(signal.SIGIO, signal.SIG_IGN)
    for path in release_dir.rglob("*") if sys.platform == "linux" else ():
        if path.is_symlink() or not path.is_file():
            continue
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            fcntl.fcntl(descriptor, fcntl.F_SETLEASE, fcntl.F_WRLCK)
        except OSError as error:
            return f"{path.name} is in use, or cannot be asked ({error.strerror})"
        finally:
            os.close(descriptor)  # which also gives the lease back
    return None


def retire(release_root: Path, release_dir: Path) -> None:
    """Keep the manifest (with its source identities) and lock, then remove; the
    manifest goes last, so a half-removed generation is found again."""
    kept = release_root / "retired" / f"{release_dir.name}-{sha256(release_dir / 'manifest.json')[:12]}"
    kept.mkdir(parents=True, exist_ok=True)
    for name in ("manifest.json", "Cargo.lock"):
        if (release_dir / name).is_file():
            shutil.copy2(release_dir / name, kept / f".{name}.new")
            fsync_file(kept / f".{name}.new")
            os.replace(kept / f".{name}.new", kept / name)
    fsync_directory(kept)
    for entry in sorted(release_dir.iterdir(), key=lambda path: (path.name == "manifest.json", path)):
        if entry.is_dir() and not entry.is_symlink():
            shutil.rmtree(entry)
        else:
            entry.unlink()
    release_dir.rmdir()


def prune(release_root: Path, *, dry_run: bool) -> int:
    """Remove every generation but the current, the previous, newer ones, those
    with a .keep file and those something holds. Returns how many removals failed."""
    releases = release_root / "releases"
    current = linked_generation(release_root / "current")
    if releases.is_symlink() or current is None:
        raise ReleaseError("pruned nothing: current or releases/ is not as installed")
    free = shutil.disk_usage(releases).free
    stamps: dict[str, float | None] = {}  # None: undated
    for path in sorted(releases.iterdir()):
        plain = path.is_dir() and not path.is_symlink() and not os.path.ismount(path)
        if not plain or not GENERATION_RE.fullmatch(path.name):
            print(f"left {path.name}: not a generation directory")
            continue
        try:
            manifest = json.loads(plain_file(path / "manifest.json"))
            if manifest["generation"] != path.name:
                raise ValueError
            stamps[path.name] = dt.datetime.fromisoformat(manifest["created_utc"]).timestamp()
        except OSError as error:
            print(f"left {path.name}: no readable manifest.json ({error.strerror or error})")
        except (ValueError, KeyError, TypeError):
            stamps[path.name] = None
    now = stamps.get(current)
    if now is None:
        raise ReleaseError(f"pruned nothing: the manifest of {current} gives no creation time")
    previous, recorded = linked_generation(release_root / "previous"), "previous"
    if previous in (None, current):
        older = {name: stamp for name, stamp in stamps.items() if stamp and stamp < now}
        previous = max(older, key=older.__getitem__, default=None)
        recorded = "taken as previous, none is recorded: the newest staged before the current"

    held: dict[str, dict[str, list[str]]] = {name: {} for name in stamps}
    unread: set[str] = set()
    unknown = None
    try:
        for who, how, text in (linux_holders if sys.platform == "linux" else macos_holders)(unread):
            for name in stamps if b"releases/" in text else ():
                if f"releases/{name}".encode() in text:
                    held[name].setdefault(who, []).append(how)
    except OSError as error:
        unknown = f"what holds it cannot be read: {error}"
    blind = f"{len(unread)} processes" if sys.platform == "linux" else "processes of other users"
    print(f"not readable: environment and working directory of {blind}")

    failures = 0
    for name, stamp in stamps.items():
        reasons = [recorded] if name == previous else []
        if stamp is None:
            reasons.append("its manifest gives no creation time for this generation")
        elif stamp > now:
            reasons.append("staged after the current")
        try:
            note = plain_file(releases / name / ".keep")[:500].decode(errors="replace")
            reasons.append(f".keep: {' '.join(note.split())}")
        except FileNotFoundError:
            pass
        except OSError as error:
            reasons.append(f".keep: cannot be read ({error.strerror or error})")
        reasons += [f"held by {who} ({', '.join(dict.fromkeys(how))})" for who, how in held[name].items()]
        reasons += [unknown] if unknown else []
        if name == current:
            reasons = ["current"]
        try:
            use = None if reasons else in_use(releases / name)
            if reasons or use:
                print(f"kept {name}: {use or '; '.join(reasons)}")
                continue
            if not dry_run:
                retire(release_root, releases / name)
            print(f"{'would remove' if dry_run else 'removed'} {name}")
        except OSError as error:
            failures += 1
            print(f"could not remove {name}: {error}", file=sys.stderr)
    print(f"free space by df: {(shutil.disk_usage(releases).free - free) / 1e9:+.2f} GB")
    return failures


def lock(releases: Path) -> None:
    """Keep this installer's activation and another's prune apart, until it exits."""
    if releases.is_dir():
        fcntl.flock(os.open(releases, os.O_RDONLY), fcntl.LOCK_EX)


def install(args: argparse.Namespace) -> dict[str, Any]:
    prefix = args.prefix.expanduser().resolve()
    release_root = prefix / "lib" / "faculties"
    if args.prune_only or args.prune_dry_run:
        if args.build_dir or args.activate_staged or args.generation or args.stage_only or args.dry_run:
            raise ReleaseError("--prune-only and --prune-dry-run stand alone")
        lock(release_root / "releases")
        if prune(release_root, dry_run=args.prune_dry_run):
            raise ReleaseError("a generation could not be removed")
        return {}
    if args.activate_staged is not None:
        if args.build_dir is not None or args.generation is not None or args.stage_only:
            raise ReleaseError(
                "--activate-staged cannot be combined with build_dir, --generation, or --stage-only"
            )
        generation = args.activate_staged
    else:
        generation, manifest = stage_release(args)
        if args.dry_run or args.stage_only:
            return manifest

    lock(release_root / "releases")
    manifest = activate_staged(prefix, generation, dry_run=args.dry_run)
    if not args.dry_run and not args.no_prune:
        try:
            prune(release_root, dry_run=False)
        except Exception as error:  # the activation stands whatever happens here
            print(f"warning: not pruned: {error}", file=sys.stderr)
    return manifest


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Stage a coherent Faculties binary cohort and atomically switch it live."
    )
    result.add_argument(
        "build_dir",
        type=Path,
        nargs="?",
        help="directory containing built executables",
    )
    result.add_argument(
        "--source-dir",
        type=Path,
        default=Path(__file__).resolve().parent.parent,
        help="Faculties source checkout (default: this script's checkout)",
    )
    result.add_argument(
        "--prefix",
        type=Path,
        default=Path("~/.local"),
        help="installation prefix (default: ~/.local)",
    )
    result.add_argument("--generation", help="versioned release generation name")
    result.add_argument(
        "--stage-only",
        action="store_true",
        help="publish and verify a write-once generation without switching current",
    )
    result.add_argument(
        "--activate-staged",
        metavar="GENERATION",
        help="verify and atomically activate an already staged generation",
    )
    result.add_argument(
        "--no-default-features",
        action="store_true",
        help="record and resolve the cohort as built without default Cargo features",
    )
    result.add_argument(
        "--features",
        default="",
        help="comma-separated Cargo features used for the build",
    )
    pruning = result.add_mutually_exclusive_group()
    pruning.add_argument(
        "--no-prune", action="store_true", help="keep old generations this time"
    )
    pruning.add_argument(
        "--prune-only",
        action="store_true",
        help="activate nothing; remove generations that are neither current, "
        "previous, newer, kept nor held",
    )
    pruning.add_argument(
        "--prune-dry-run",
        action="store_true",
        help="print what --prune-only would do; remove nothing",
    )
    result.add_argument(
        "--dry-run", action="store_true", help="validate and print manifest only"
    )
    return result


def main() -> int:
    try:
        install(parser().parse_args())
    except ReleaseError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
